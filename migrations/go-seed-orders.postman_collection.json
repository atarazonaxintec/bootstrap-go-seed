{
  "info": {
    "name": "Go Seed - Orders API",
    "description": "Requests for the orders, payments, and products routes declared by the orders router.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3200/api"
    },
    {
      "key": "rut",
      "value": "12345678-9"
    },
    {
      "key": "orderId",
      "value": "replace-with-order-id"
    },
    {
      "key": "sku",
      "value": "SKU-001"
    }
  ],
  "item": [
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders/{{rut}}"
          }
        },
        {
          "name": "Update order",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{orderId}}\",\n  \"rut\": \"{{rut}}\",\n  \"sub_total\": 64980,\n  \"order_items\": [\n    {\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Get order by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        {
          "name": "Get orders by RUT",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/rut/{{rut}}"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create payment for order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/payments/{{orderId}}"
          }
        },
        {
          "name": "Get payments by order ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/payments/order/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get all products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Get product by SKU",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{sku}}"
          }
        }
      ]
    }
  ]
}
